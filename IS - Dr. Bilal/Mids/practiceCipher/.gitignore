# === C++ / Executables ===
# Ignore compiled executables generated by your compiler
*.exe
*.out
*.app
src/output/

# === Python ===
# Ignore Python bytecode and cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Python virtual environments
venv/
.venv/
env/
.env/

# === VS Code / IDEs ===
# Ignore user-specific IDE workspace settings
.vscode/
.idea/

# === OS Generated Files ===
# Ignore system-specific files
.DS_Store
Thumbs.db
